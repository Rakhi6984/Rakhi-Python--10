    "## PRIME NUMBER"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1b14fad4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2 is not a Prime Number\n"
     ]
    }
   ],
   "source": [
    "num =  int(input(\"Enter a number:\"))\n",
    "if num > 1:\n",
    "    for i in range(2, num):\n",
    "        if num % i == 0:\n",
    "            print(num,\"is not a Prime Number\")\n",
    "        else:\n",
    "            print(num, \"is a Prime Number\")\n",
    "    else:\n",
    "        print(num, \"is not a Prime Number\")"
   ]
